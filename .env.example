# Base de datos de desarrollo (PostgreSQL 16+)
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/citaclara?schema=public"

# Base de datos de test (usada por tests de integracion, p. ej. concurrencia RN1)
DATABASE_URL_TEST="postgresql://usuario:contrasena@localhost:5432/citaclara_test?schema=public"

# Secreto para firmar la cookie de sesion de secretaria (cadena aleatoria larga)
SESSION_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"

# Clave de secretaria usada por la semilla determinista (prisma/seed.ts) para
# generar el hash almacenado en Despacho.claveSecretariaHash (FR-001, FR-015)
SEED_CLAVE_SECRETARIA="secretaria2026"

# Secreto para firmar la cookie de sesion del portal del cliente (002-portal-cliente-citas),
# distinto de SESSION_SECRET (cadena aleatoria larga)
PORTAL_SESSION_SECRET="cambia-este-valor-por-otro-secreto-largo-y-aleatorio"
